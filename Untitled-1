import React, {
  useState,
  useEffect,
  useCallback,
  Dispatch,
  SetStateAction
} from 'react';
import {
  BlockManagerDragDrop,
  BlockConfig,
} from '@umbriel/components';
import api from '@/services/api';
import { useListArticles, usePages } from '@/app/hooks/react-query/useQuery';
import { tenantIdStorageKey } from '@/store/features/login/by-crud-operations/read/keys';
import { getTenantUrl } from '@/app/utils/tenant-url';
import { deliveryUserToken } from '@/app/global.token';
import { Tabs, TabsList, TabsTrigger, TabsContent } from '@/components/ui/tabs';
import {
  Select,
  SelectTrigger,
  SelectValue,
  SelectContent,
  SelectItem
} from '@/components/ui/select';
import { Skeleton } from '@/components/ui/skeleton';

// Define interfaces for component props
interface TabPagesProps {
  selectedPage: string | null;
  setSelectedPage: Dispatch<SetStateAction<string | null>>;
  isPagesLoading: boolean;
  pageData: Array<{ id: string; title: string }> | undefined;
}

interface VariantSelectorProps {
  blockType: string;
  selectedVariant: string;
  setSelectedVariant: Dispatch<SetStateAction<string>>;
}

interface BlockTypeSelectorProps {
  blockType: string;
  setBlockType: Dispatch<SetStateAction<string>>;
}

// Define these components outside the main component
const TabPages = ({
  selectedPage,
  setSelectedPage,
  isPagesLoading,
  pageData
}: TabPagesProps) => {
  return (
    <Tabs defaultValue="pages" className="w-full mb-4">
      <TabsList className="w-full">
        <TabsTrigger value="pages" className="flex-1">
          Pages
        </TabsTrigger>
      </TabsList>
      <TabsContent value="pages" className="w-full">
        <Select value={selectedPage || ''} onValueChange={setSelectedPage}>
          <SelectTrigger className="w-full">
            <SelectValue placeholder="Select a page" />
          </SelectTrigger>
          <SelectContent>
            {isPagesLoading ? (
              <Skeleton className="w-full h-8" />
            ) : (
              pageData?.map((page) => (
                <SelectItem key={page.id} value={page.id}>
                  {page.title}
                </SelectItem>
              ))
            )}
          </SelectContent>
        </Select>
      </TabsContent>
    </Tabs>
  );
};

const VariantSelector = ({
  blockType,
  selectedVariant,
  setSelectedVariant
}: VariantSelectorProps) => {
  // Define available variants based on the selected block type
  const getVariantOptions = () => {
    switch (blockType) {
      case 'grid':
        return [
          { value: 'standard', label: 'Standard Grid' },
          { value: 'featured', label: 'Featured Grid' },
          { value: 'masonry', label: 'Masonry Grid' },
          { value: 'sidebargrid', label: 'Sidebar Grid' },
          { value: 'newsfeed', label: 'News Feed' },
          { value: 'newsgrid', label: 'News Grid' }
        ];
      case 'list':
        return [
          { value: 'chronological', label: 'Chronological List' },
          { value: 'compact', label: 'Compact List' },
          { value: 'card', label: 'Card List' }
        ];
      case 'featured':
        return [
          { value: 'hero', label: 'Hero Featured' },
          { value: 'split', label: 'Split Featured' },
          { value: 'triple', label: 'Triple Featured' }
        ];
      case 'mixed':
        return [
          { value: 'sidebar', label: 'Sidebar Mixed' },
          { value: 'showcase', label: 'Showcase Mixed' },
          { value: 'newspaper', label: 'Newspaper Mixed' },
          { value: 'magazine', label: 'Magazine Mixed' },
          { value: 'videogrid', label: 'Video Grid Mixed' }
        ];
      default:
        return [{ value: 'standard', label: 'Standard' }];
    }
  };

  const variantOptions = getVariantOptions();

  return (
    <div className="flex items-center gap-2 mb-4">
      <span className="font-medium">Variante:</span>
      <Select value={selectedVariant} onValueChange={setSelectedVariant}>
        <SelectTrigger className="w-40">
          <SelectValue />
        </SelectTrigger>
        <SelectContent>
          {variantOptions.map((option) => (
            <SelectItem key={option.value} value={option.value}>
              {option.label}
            </SelectItem>
          ))}
        </SelectContent>
      </Select>
    </div>
  );
};

const BlockTypeSelector = ({
  blockType,
  setBlockType
}: BlockTypeSelectorProps) => {
  return (
    <div className="flex items-center gap-2 mb-4">
      <span className="font-medium">Tipo de Bloco:</span>
      <Select value={blockType} onValueChange={setBlockType}>
        <SelectTrigger className="w-40">
          <SelectValue />
        </SelectTrigger>
        <SelectContent>
          <SelectItem value="grid">Grid</SelectItem>
          <SelectItem value="list">Lista</SelectItem>
          <SelectItem value="featured">Destaque</SelectItem>
          <SelectItem value="mixed">Misto</SelectItem>
        </SelectContent>
      </Select>
    </div>
  );
};

// Error notification component
const ErrorNotification = ({
  message,
  onClose
}: {
  message: string;
  onClose: () => void;
}) => (
  <div className="fixed top-4 right-4 bg-red-500 text-white p-4 rounded-md shadow-lg z-50">
    <div className="flex justify-between items-center">
      <span>{message}</span>
      <button onClick={onClose} className="ml-4 text-white">
        ×
      </button>
    </div>
  </div>
);

// Success notification component
const SuccessNotification = ({
  message,
  onClose
}: {
  message: string;
  onClose: () => void;
}) => (
  <div className="fixed top-4 right-4 bg-green-500 text-white p-4 rounded-md shadow-lg z-50">
    <div className="flex justify-between items-center">
      <span>{message}</span>
      <button onClick={onClose} className="ml-4 text-white">
        ×
      </button>
    </div>
  </div>
);

const BlockBuilder = () => {
  const { data: listArticlesResponse, isLoading: isListArticlesLoading } =
    useListArticles(1, 50);
  const { data: pageData, isLoading: isPagesLoading } = usePages();

  const [error, setError] = useState<string | null>(null);
  const [blockData, setBlockData] = useState<any>(null);
  const [isDarkTheme, setIsDarkTheme] = useState(false);
  const [successMessage, setSuccessMessage] = useState<string | null>(null);
  const [errorMessage, setErrorMessage] = useState<string | null>(null);
  const [selectedPage, setSelectedPage] = useState<string | null>(null);
  const [selectedVariant, setSelectedVariant] = useState<string>('standard');
  const [blockType, setBlockType] = useState<string>('grid');
  const [isMounted, setIsMounted] = useState(false);

  // Set isMounted to true after component mounts
  useEffect(() => {
    setIsMounted(true);
    return () => setIsMounted(false);
  }, []);

  // Update variant when block type changes
  useEffect(() => {
    // Reset to default variant when block type changes
    switch (blockType) {
      case 'grid':
        setSelectedVariant('standard');
        break;
      case 'list':
        setSelectedVariant('chronological');
        break;
      case 'featured':
        setSelectedVariant('hero');
        break;
      case 'mixed':
        setSelectedVariant('sidebar');
        break;
      default:
        setSelectedVariant('standard');
    }
  }, [blockType]);

  useEffect(() => {
    // Only fetch data if component is mounted and a page is selected
    if (isMounted && selectedPage) {
      const fetchBlockData = async () => {
        try {
          const baseUrl = getTenantUrl();
          const tenantId = localStorage.getItem(tenantIdStorageKey);
          const response = await api.get(
            `${baseUrl}/private/page-blocks/v2/page/${selectedPage}`,
            {
              headers: {
                auth: deliveryUserToken,
                'x-tenant-id': tenantId
              }
            }
          );

          if (response.data && response.data.length > 0) {
            const blockDataResponse = response.data.find((block: any) => block.blockType === 'articles') || response.data[0];
            setBlockData(blockDataResponse);
            
            if (blockDataResponse.template) {
              setBlockType(blockDataResponse.template);
            }
            
            if (
              blockDataResponse.variants &&
              blockDataResponse.variants.length > 0
            ) {
              setSelectedVariant(
                blockDataResponse.variants[0].variantType || 'standard'
              );
            }
          } else {
            // Reset to default state if no data found
            setBlockData(null);
          }
        } catch (err: any) {
          console.error('Erro ao buscar dados do bloco:', err);
          setError('Falha ao carregar dados do bloco. Por favor, tente novamente.');
        }
      };

      fetchBlockData();
    }
  }, [selectedPage, isMounted]);

  // Configuração padrão do bloco
  const defaultBlockConfig: BlockConfig = {
    layout: {
      columns: '3',
      gap: '6',
      styles: {
        width: '100%',
        backgroundColor: 'transparent'
      }
    },
    styles: {
      theme: {
        light: {
          columnStyle: {
            background: '#ffffff',
            padding: '1rem'
          },
          headingProps: {
            fontSize: '1.125rem',
            fontWeight: '500',
            color: '#111827'
          },
          subtitleProps: {
            fontSize: '0.875rem',
            color: '#6B7280'
          }
        },
        dark: {
          columnStyle: {
            background: '#1F2937',
            padding: '1rem'
          },
          headingProps: {
            fontSize: '1.125rem',
            fontWeight: '500',
            color: '#F9FAFB'
          },
          subtitleProps: {
            fontSize: '0.875rem',
            color: '#9CA3AF'
          }
        }
      },
      showExcerpt: true,
      showMetadata: true,
      titleSize: 'text-lg'
    }
  };

  // Função para salvar os dados do bloco
  const handleSave = async (data: any) => {
    if (!selectedPage) {
      setErrorMessage('Por favor, selecione uma página antes de salvar.');
      setTimeout(() => setErrorMessage(null), 5000);
      return;
    }

    try {
      const baseUrl = getTenantUrl();
      const tenantId = localStorage.getItem(tenantIdStorageKey);

      // Log detalhado dos dados recebidos do componente
      console.log('Dados recebidos do BlockManagerDragDrop:', JSON.stringify(data, null, 2));
      
      // Criar uma cópia limpa dos dados para não modificar o original
      // Apenas copiamos os campos que sabemos que são necessários
      const saveData: any = {
        pageId: selectedPage,
        blockType: 'articles',
        template: blockType,
        blockPosition: data.blockPosition || 1,
        variants: []
      };
      
      // Copiar as variantes sem incluir IDs
      if (data.variants && data.variants.length > 0) {
        data.variants.forEach((variant: any, index: number) => {
          const newVariant: any = {
            variantType: variant.variantType,
            variantPosition: variant.variantPosition || index + 1,
            config: {
              layout: variant.config?.layout ? { ...variant.config.layout } : undefined,
              articles: variant.config?.articles ? { ...variant.config.articles } : undefined,
              styles: variant.config?.styles ? { ...variant.config.styles } : undefined
            }
          };
          
          saveData.variants.push(newVariant);
        });
      }
      
      // Configurar o endpoint e método
      const endpoint = `${baseUrl}/private/page-blocks/v2/create`;
      const method = 'post';

      console.log('Dados a serem salvos:', JSON.stringify(saveData, null, 2));
      console.log('Endpoint:', endpoint);
      console.log('Método:', method);
      console.log('Operação: Criação');
      
      const response = await api({
        method,
        url: endpoint,
        data: saveData,
        headers: {
          auth: deliveryUserToken,
          'x-tenant-id': tenantId
        }
      });

      const result = response.data;
      console.log('Resposta da API:', JSON.stringify(result, null, 2));

      // Atualizar o estado local com os dados salvos
      setBlockData(result);

      // Exibir notificação de sucesso
      setSuccessMessage('Bloco criado com sucesso!');
      setTimeout(() => setSuccessMessage(null), 3000);
    } catch (error: any) {
      console.error('Erro ao criar o bloco:', error);
      console.error('Detalhes do erro:', error.response?.data || error.message);
      setErrorMessage(error.message || 'Erro ao criar o bloco. Por favor, tente novamente.');
      setTimeout(() => setErrorMessage(null), 5000);
    }
  };

  // Toggle para o tema escuro
  const toggleTheme = () => {
    setIsDarkTheme((prev) => !prev);
  };

  if (isListArticlesLoading || isPagesLoading) {
    return (
      <div className="flex justify-center items-center h-64 w-full">
        <div className="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-blue-500"></div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative w-full">
        Erro: {error}
      </div>
    );
  }

  // Extrair a configuração do bloco se disponível
  const config = blockData?.variants?.[0]?.config || defaultBlockConfig;

  return (
    <div className="w-full max-w-full p-4 overflow-x-hidden">
      <TabPages
        selectedPage={selectedPage}
        setSelectedPage={setSelectedPage}
        isPagesLoading={isPagesLoading}
        pageData={pageData}
      />
      {errorMessage && (
        <ErrorNotification
          message={errorMessage}
          onClose={() => setErrorMessage(null)}
        />
      )}
      {successMessage && (
        <SuccessNotification
          message={successMessage}
          onClose={() => setSuccessMessage(null)}
        />
      )}
      <div className="flex flex-col md:flex-row gap-4 mb-4">
        <BlockTypeSelector blockType={blockType} setBlockType={setBlockType} />
        <VariantSelector 
          blockType={blockType}
          selectedVariant={selectedVariant}
          setSelectedVariant={setSelectedVariant}
        />
        <div className="ml-auto">
          <button
            onClick={toggleTheme}
            className={`px-3 py-2 rounded-md ${
              isDarkTheme
                ? 'bg-gray-700 text-white hover:bg-gray-600'
                : 'bg-gray-200 text-gray-800 hover:bg-gray-300'
            }`}
          >
            {isDarkTheme ? 'Modo Claro' : 'Modo Escuro'}
          </button>
        </div>
      </div>
      {selectedPage ? (
        <BlockManagerDragDrop
          articles={listArticlesResponse?.articles || []}
          blockType={blockType as 'grid' | 'list' | 'mixed' | 'featured'}
          isDarkTheme={isDarkTheme}
          onSave={handleSave}
          variant={selectedVariant}
          pageId={selectedPage}
          config={config}
          className="w-full"
        />
      ) : (
        <div className="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-4">
          <div className="flex">
            <div className="flex-shrink-0">
              <svg
                className="h-5 w-5 text-yellow-400"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fillRule="evenodd"
                  d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
                  clipRule="evenodd"
                />
              </svg>
            </div>
            <div className="ml-3">
              <p className="text-sm text-yellow-700">
                Por favor, selecione uma página para começar.
              </p>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default BlockBuilder;